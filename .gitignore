model_cache/

# Specific model weight file extensions (safety net)
*.bin
*.safetensors
*.gguf
*.ggml
*.pt
*.pth
*.ckpt
*.h5


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# DATA — raw PDFs and auto-generated indexes (large files)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Raw PDFs (your thesis chapters + research papers)
# These live on your machine and should not be in version control
data/raw/thesis/*.pdf
data/raw/papers/*.pdf

# Auto-generated during ingestion — re-created by running run_ingestion.py
data/processed/chunks/
data/processed/bm25_index.pkl
data/processed/dedup_hashes.pkl

# RAGAS evaluation outputs — re-generated by run_evaluation.py
data/evaluation/ragas_results/

# Keep the folder structure and the hand-crafted test questions
!data/raw/thesis/.gitkeep
!data/raw/papers/.gitkeep
!data/processed/.gitkeep
!data/evaluation/test_questions.json


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
